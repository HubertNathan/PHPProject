{% extends 'base.html.twig' %}

{% block title %}Starship index{% endblock %}

{% block body %}
    <h1>Starship index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for starship in starships %}
            <tr>
                <td>{{ starship.id }}</td>
                <td>{{ starship.name }}</td>
                <td>{{ starship.description }}</td>
                <td>
                    <a href="{{ path('app_starship_show', {'id': starship.id}) }}">show</a>
                    <a href="{{ path('app_starship_edit', {'id': starship.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <a href="{{ path('app_starship_new', {'id': app.user.agency.id }) }}">Add new</a>
{% endblock %}
