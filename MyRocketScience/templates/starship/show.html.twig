{% extends "base.html.twig" %}
{% block title %}<title>{{ starship.name }}</title>{% endblock %}

{% block body %}
    <h1>{{starship.name}}</h1>

       {% dump starship %}

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ starship.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ starship.name }}</td>
            </tr>
            <tr>
                <th>Agency : </th>
                <td><a href="{{ path('agency_show',{'id':starship.agency.id})}}">{{ starship.agency.name }}</a></td>
            </tr>

        </tbody>
    </table>

{% endblock %} {# body #} 
