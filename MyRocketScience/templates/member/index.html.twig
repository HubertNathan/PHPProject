{% extends 'base.html.twig' %}

{% block body %}
    <h1>Member List</h1>

    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>username</th>
            <th>email</th>
        </tr>
        </thead>
        <tbody>
        {% for member in members %}
            <tr>
                <td>{{ member.id }}</td>
                <td><a href="{{ path('app_member_show', {'id' : member.id}) }}"> {{ member.username }} </a></td>
                <td>{{ member.email }}</td>
                <td>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
