{% extends "base.html.twig" %}
{% block head%}
<head>
    <meta charset="UTF-8">
    <title> {% block title %}
            {% set current_path = app.request.get('') %}
            {{ current_path }}
        {% endblock %}</title>
</head>
{% endblock %}
{% block body %}
    <body>
        <div class="example-wrapper">
            <h1>Here's the agency list!</h1>
            <div class = displayList>
                <ul>
                    {% for agency in agencyRepo %}
                    <li> <a href="{{ path('app_agency_show',{'id':agency.id})}}">{{ agency.name}}</li>
                    {% endfor %}
                </ul>
            </div>

        </div>
</body>
{% endblock %}
