{% extends "base.html.twig" %}
{# ... #}
{% block title %}<title>{{ Agency.name }}</title>{% endblock %}
{% block body %}
    <div class = "header">
        <h1>Agency</h1>
    </div>

       {% dump Agency %}
    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ Agency.id }}</td>
            </tr>
            <tr>
                <th>Name : </th>
                <td>{{ Agency.name }}</td>
            </tr>
            <tr>
                <th> Location : </th>
                <td>{{ Agency.location}}
            </tr>

        </tbody>
    </table>
    {% for starship in Agency.starships %}
    <li><a href="{{ path('app_starship_show',{'id':starship.id})}}">{{ starship.name }}</a></li>
    {% endfor %}

    <a href="{{ path('Agency List') }}">back to list</a>

{% endblock %} {# body #} 
{# ... #} 